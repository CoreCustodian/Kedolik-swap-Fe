VITE_RPC_ENDPOINT=https://solana-mainnet.g.alchemy.com/v2/Dhic93HjH_skAKIwCUAVC
# WebSocket endpoint. Optional — derived from VITE_RPC_ENDPOINT when omitted.
# Setting it enables push-based balance/pool/signature updates instead of polling,
# which is the single largest RPC quota saver.
VITE_RPC_ENDPOINT_WS=wss://solana-mainnet.g.alchemy.com/v2/Dhic93HjH_skAKIwCUAVC
VITE_NETWORK=mainnet-beta
VITE_DEBUG=true

# Jupiter API key from https://developers.jup.ag/portal
# Required for Jupiter swap routing and token search (mainnet only)
VITE_JUPITER_API_KEY=your_jupiter_api_key_here

# Jupiter integrator fees — see scripts/setup-jupiter-referral.ts
# VITE_JUPITER_REFERRAL_ACCOUNT = Jupiter referral PDA from setup (NOT your wallet)
# Fee wallet EGX4... claims earnings at https://referral.jup.ag/dashboard
VITE_JUPITER_REFERRAL_ACCOUNT=
VITE_JUPITER_REFERRAL_FEE_BPS=100

# Smart routing: if a Kedolik pool exists but a trade's price impact on our
# pool exceeds this percentage, compare against Jupiter/OKX and route to the best
# price. Below this, trades always stay on the Kedolik DEX. Default: 5
VITE_MAX_DEX_PRICE_IMPACT_PERCENT=5

# OKX Web3 DEX API — https://web3.okx.com/onchainos/dev-docs/waas/introduction-to-developer-portal-interface
# 1. Sign in at OKX Developer Portal and create a project
# 2. Generate API Key, Secret Key, and Passphrase
# 3. Copy the Project ID from your project settings
# SECURITY: Secret/passphrase in VITE_* are exposed in the client bundle.
# For production, proxy OKX requests through your backend.
VITE_OKX_API_KEY=your_okx_api_key_here
VITE_OKX_SECRET_KEY=your_okx_secret_key_here
VITE_OKX_PASSPHRASE=your_okx_passphrase_here
VITE_OKX_PROJECT_ID=your_okx_project_id_here
# Optional: use /okx-api in dev if CORS blocks direct calls (see vite.config.ts proxy)
# VITE_OKX_API_BASE=https://web3.okx.com
# Optional integrator fee (0–10%) and fee receiver wallet on Solana
# VITE_OKX_FEE_PERCENT=1
# VITE_OKX_REFERRER_WALLET=your_solana_wallet_address

# Global aggregator volume (Vercel serverless + Blob — no traditional DB)
# 1. Vercel dashboard → Storage → Blob → create store (choose **Private**)
# 2. Set SOLANA_RPC_URL on Vercel (same as VITE_RPC_ENDPOINT) for tx verification
# Optional local dev: proxy /api to production (see vite.config.ts)
# VITE_AGGREGATOR_VOLUME_API=https://your-app.vercel.app
